# Discord bot token (Developer Portal -> your app -> Bot -> Reset Token).
# Requires the "Message Content", "Server Members", and voice permissions
# (Connect, Speak, Use Voice Activity) intents/permissions enabled.
DISCORD_BOT_TOKEN=

# Anthropic API key (console.anthropic.com -> API Keys). Used for the DM
# assistant chat -- voice transcription runs locally and does not need this.
ANTHROPIC_API_KEY=

# Name of the text channel transcripts get posted to. Must already exist in
# the server; the bot does not create it for you.
TRANSCRIPTION_CHANNEL_NAME=transcription

# Optional: comma-separated list of campaign-specific names (PCs, recurring
# NPCs, homebrew places) to bias the transcriber toward, e.g.
# CAMPAIGN_VOCAB=Aldric Thornwood,Vesper Kane,the Sunken Archive
CAMPAIGN_VOCAB=

# Optional: force the Whisper device/precision instead of auto-detecting a
# GPU. Leave blank to auto-try CUDA and fall back to CPU. Set
# WHISPER_DEVICE=cpu to skip the GPU attempt entirely (e.g. while debugging
# a cuDNN/PATH issue -- see README.md's GPU setup section).
WHISPER_DEVICE=
WHISPER_COMPUTE_TYPE=

# Which Claude models to use. Each is either a pinned model ID, or
# latest-<family> (latest-haiku, latest-sonnet, latest-opus) to use the newest
# model of that family the API offers, looked up once at bot start and logged.
# Chat follows the newest Haiku. The recap is pinned on purpose: a new model
# version can behave differently under the same settings (Opus 5.5 at the
# effort that suited Opus 5 burned its whole budget and wrote nothing), so only
# switch it to latest-opus alongside a test recap.
CHAT_MODEL=latest-haiku
RECAP_MODEL=claude-opus-5-5

# Channels for the quote board and the open-threads board. Both must already
# exist -- the bot never creates channels.
QUOTES_CHANNEL_NAME=quotes
TODO_CHANNEL_NAME=potjf-to-do
RELEASE_CHANNEL_NAME=dndbot-release-notes
